@page "/"
@using SWTIWOOCMTG
@inject Game Game
@inject GameSession Session
@implements IDisposable

@if (screen == Screen.MainMenu)
{
    <div class="menu-screen">
        <img class="board-art" src="_content/SWTIWOOCMTG.UI/images/board-logo.svg" alt="SWTIWOOCMTG" />
        <button @onclick="StartGame">Start Game</button>
        <button @onclick="Quit">Quit</button>
    </div>
}
else if (screen == Screen.PlayerCount)
{
    <div class="menu-screen">
        <h2>How many players?</h2>
        <input type="number" min="2" max="8" @bind="playerCountInput" />
        <button @onclick="ConfirmPlayerCount">Confirm</button>
        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:red">@error</p>
        }
    </div>
}
else if (screen == Screen.PlayerNames)
{
    <div class="menu-screen">
        <h2>Player @(Game.Players.Count + 1) of @targetPlayerCount — enter name:</h2>
        <input @bind="nameInput" @bind:event="oninput"
               @onkeyup="@(e => { if (e.Key == "Enter") AddPlayer(); })" />
        <label>
            <input type="checkbox" @bind="isCpuInput" />
            CPU Player
        </label>
        <button @onclick="AddPlayer">Next</button>
        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:red">@error</p>
        }
    </div>
}
else if (screen == Screen.HouseRules)
{
    <div class="menu-screen">
        <h2>House Rules</h2>

        <label>
            <input type="checkbox" @bind="Game.Rules.Jackpot" />
            Jackpot: LOTTO! space pays out accumulated pot.
        </label>

        <label>
            <input type="checkbox" @bind="Game.Rules.PrisonGenPop" />
            Gen Pop Prison: A prison tier that's a bit harsher than That Other Game.
        </label>

        <label>
            <input type="checkbox" @bind="Game.Rules.PropertyColorGroups" />
            Property Color Groups: Classic build rules. Own the whole color group to upgrade, build and sell evenly, no upgrading or mortgaging around a mortgaged/upgraded group mate.
        </label>

        <label>
            <input type="checkbox" @bind="Game.Rules.Gentrification" />
            Gentrification: TO-DO! <b>NOT IMPLEMENTED YET!</b>
        </label>

        <label>
            <input type="checkbox" @bind="Game.Rules.ArfenhouseRule" />
            Arfenhouse Rule: harsher, targeted card effects aimed at that <em>one player</em> who everyone wants to give a hard time.
        </label>

        @if (Game.Rules.ArfenhouseRule)
        {
            <div class="arfenhouse-select">
                <p>Nominate who should be this game's stupid butthole:</p>
                @foreach (var p in Game.Players)
                {
                    <label>
                        <input type="checkbox"
                               checked="@arfenhouseNominees.Contains(p)"
                               @onchange="@(() => ToggleArfenhouseNominee(p))" />
                        @p.Name
                    </label>
                }
                <p><em>Note: in online play, the nominated player will need to confirm they accept the harsher rules before the game starts. If more than one player is nominated, everyone else votes on who it'll be.</em></p>
            </div>
        }

        <button @onclick="BeginGame">Start Playing</button>
    </div>
}

else if (screen == Screen.ArfenhouseVote)
{
    <div class="menu-screen">
        <h2>Vote: Which one of these stupid buttholes do you want to make life miserable for?</h2>
        <p>@votingPlayers[votingPlayerIndex].Name, cast your vote:</p>
        @foreach (var nominee in arfenhouseNominees)
        {
            <button @onclick="@(() => CastArfenhouseVote(nominee))">@nominee.Name</button>
        }
    </div>
}
else if (screen == Screen.Board)
{
    <div class="board-wrapper">
        <img class="board-bg" src="_content/SWTIWOOCMTG.UI/images/board-logo.svg" alt="board" />
        @for (int i = 0; i < 40; i++)
        {
            var idx = i;
            var (leftPct, topPct) = GetTokenPosition(idx);
            @foreach (var p in Game.Players.Where(pl => pl.Position == idx))
            {
                <img class="token" src="_content/SWTIWOOCMTG.UI/images/token@(p.TokenNumber).svg" title="@p.Name"
                     style="left:@(leftPct)%; top:@(topPct)%;" />
            }
        }
    </div>

    <div class="hud">
    @if (Session.Die1 != null && Session.Die2 != null)
    {
        <div class="dice-row">
            <img class="die" src="_content/SWTIWOOCMTG.UI/images/whitedice_@(Session.Die1).svg" alt="die 1" />
            <img class="die" src="_content/SWTIWOOCMTG.UI/images/reddice_@(Session.Die2).svg" alt="die 2" />
        </div>
    }
    @if (!string.IsNullOrEmpty(Session.CurrentRoll))
    {
        <p>@Session.CurrentRoll</p>
    }

    @if (!string.IsNullOrEmpty(Game.LastCardText))
    {
        <div class="card-flavor"><em>@Game.LastCardText</em></div>
    }

    @if (Session.Phase == TurnPhase.AwaitingRoll)
    {
        @if (Game.CurrentPlayer?.Prison != PrisonStatus.Free)
        {
            <p>@Game.CurrentPlayer?.Name is in prison.</p>
            <button @onclick="() => Session.PayBail()">Pay Bail</button>
            <button @onclick="() => Session.AttemptAppeal()">Roll for Doubles</button>
            if (Game.CurrentPlayer?.LawyerTokens > 0)
            {
                <button @onclick="() => Session.UseLawyerToken()">Use Lawyer Token to move to Minimal Security</button>
            }
            if (Game.CurrentPlayer?.GoojfCards.Any() == true){
                <button @onclick="() => Session.UseGoojfCard()">Use Get Out of Jail Free Card</button>
            }
        }
        else
        {
            <p>@Game.CurrentPlayer?.Name's turn — ₿@Game.CurrentPlayer?.Money</p>
            <button @onclick="() => Session.Roll()">Roll Dice</button>
            <button @onclick="Session.OpenPropertyManager">Manage Properties</button>
        }
    }
    else if (Session.Phase == TurnPhase.AwaitingPurchase && Session.PendingPurchase != null)
    {
        <p>Buy @Session.PendingPurchase.Name for ₿@Session.PendingPurchase.Price?</p>
        <button @onclick="() => Session.Buy()">Buy</button>
        <button @onclick="() => Session.SkipPurchase()">Skip</button>
    }
    else if (Session.Phase == TurnPhase.AwaitingSpecialPurchase && Game.PendingSpecialPurchase != null)
    {
        <p>Buy @Game.PendingSpecialPurchase.Name for ₿@Game.PendingSpecialPrice (special tribute price)?</p>
        <button @onclick="() => Session.BuySpecialProperty()">Buy</button>
        <button @onclick="() => Session.SkipSpecialPurchase()">Skip</button>
    }
    else if (Session.Phase == TurnPhase.ManageProperties)
{
    <div class="menu-screen">
        <h2>Manage Properties</h2>
        <p>Standard Upgrade Resources: @Game.LevelsAvailable | Max Upgrade Resources: @Game.MaxesAvailable</p>

        @foreach (var prop in Session.ManagingPlayer?.Properties ?? new List<BoardSpace>())
        {
            <div class="property-row">
                <span>
                    @prop.Name
                    @(prop.Type == SpaceType.Property ? $" — Lv.{(prop.Level == 5 ? "MAX" : prop.Level.ToString())}" : "")
                    @(prop.IsMortgaged ? " (Mortgaged)" : "")
                </span>

                @if (prop.Type == SpaceType.Property)
                {
                    <button @onclick="@(() => Session.UpgradeProperty(prop))" disabled="@(prop.Level >= 5)">Upgrade (₿@prop.UpgradeCost)</button>
                    <button @onclick="@(() => Session.DowngradeProperty(prop))" disabled="@(prop.Level <= 0)">Sell Upgrade (+₿@(prop.UpgradeCost / 2))</button>
                }

                @if (!prop.IsMortgaged)
                {
                    <button @onclick="@(() => Session.MortgageProperty(prop))" disabled="@(prop.Level > 0)">Mortgage (+₿@prop.MortgageValue)</button>
                }
                else
                {
                    <button @onclick="@(() => Session.UnmortgageProperty(prop))">Unmortgage (₿@prop.UnmortgageCost)</button>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Session.Error))
        {
            <p style="color:red">@Session.Error</p>
        }

        <button @onclick="Session.ClosePropertyManager">Back</button>
    </div>
        }
        else if (Session.Phase == TurnPhase.SettlingDebt && Game.CurrentDebt != null)
{
    <div class="menu-screen">
        <h2>Debt!</h2>
        <p>@Game.CurrentDebt.Debtor.Name owes ₿@Game.CurrentDebt.Amount @(Game.CurrentDebt.Creditor != null ? $"to {Game.CurrentDebt.Creditor.Name}" : "to the Bank") — only has ₿@Game.CurrentDebt.Debtor.Money.</p>
        <p>Sell upgrades or mortgage properties to raise cash.</p>

        <button @onclick="Session.OpenPropertyManager">Manage Properties</button>
        <button @onclick="() => Session.PayDebt()" disabled="@(Game.CurrentDebt.Debtor.Money < Game.CurrentDebt.Amount)">Pay Debt</button>
        <button @onclick="() => Session.DeclareBankruptcy()">Declare Bankruptcy</button>

        @if (!string.IsNullOrEmpty(Session.Error))
        {
            <p style="color:red">@Session.Error</p>
        }
    </div>
}

    <div class="log">
        @foreach (var line in Game.Log.TakeLast(6))
        {
            <p>@line</p>
        }
    </div>
</div>
}

<button @onclick="ExportLog">Export Log</button>

@code {
    // Menu-flow state lives here; in-game turn state lives in GameSession.
    enum Screen { MainMenu, PlayerCount, PlayerNames, HouseRules, ArfenhouseVote, Board, GameOver }

    Screen screen = Screen.MainMenu;

    int playerCountInput = 2;
    int targetPlayerCount;
    string nameInput = "";
    bool isCpuInput = false;
    string error = ""; // menu-screen validation only; in-game errors use Session.Error
    List<Player> arfenhouseNominees = new();
    Dictionary<Player, int> arfenhouseVotes = new();
    List<Player> votingPlayers = new();
    int votingPlayerIndex = 0;

    protected override void OnInitialized()
    {
        // The CPU driver mutates Session/Game state on its own schedule; re-render when it does.
        Session.Changed += OnSessionChanged;
    }

    void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;

    void StartGame() => screen = Screen.PlayerCount;

    void ExportLog() => Game.ExportLog("gamelog.txt");

    void ConfirmPlayerCount()
    {
        if (Game.TrySetPlayerCount(playerCountInput, out error))
        {
            targetPlayerCount = playerCountInput;
            screen = Screen.PlayerNames;
        }
    }

    void AddPlayer()
    {
        if (Game.TryAddPlayer(nameInput, out error))
        {
            Game.Players[^1].TokenNumber = Game.Players.Count;
            if (isCpuInput)
                Game.Players[^1].Ai = new PlaceholderPlayerAI();
            nameInput = "";
            isCpuInput = false;
            if (Game.Players.Count >= targetPlayerCount)
                screen = Screen.HouseRules;
        }
    }

    void ToggleArfenhouseNominee(Player p)
    {
        if (arfenhouseNominees.Contains(p))
            arfenhouseNominees.Remove(p);
        else
            arfenhouseNominees.Add(p);
    }

    void BeginGame()
    {
        if (Game.Rules.ArfenhouseRule)
        {
            if (arfenhouseNominees.Count == 0)
            {
                error = "Nominate at least one player to be this game's stupid butthole.";
                return;
            }

            error = "";

            if (arfenhouseNominees.Count == 1)
            {
                // TODO (online play): require the nominated player to explicitly
                // confirm they accept the harsher Arfenhouse rules before this locks in.
                Game.ArfPlayer = arfenhouseNominees[0];
                Game.Log.Add($"{Game.ArfPlayer.Name} has been chosen as this game's stupid butthole.");
                EnterBoard();
                return;
            }

            votingPlayers = Game.Players.Where(p => !arfenhouseNominees.Contains(p)).ToList();

            if (votingPlayers.Count == 0)
            {
                // Everyone got nominated — no one left to vote, so pick randomly.
                Game.ArfPlayer = arfenhouseNominees[new Random().Next(arfenhouseNominees.Count)];
                EnterBoard();
                return;
            }

            votingPlayerIndex = 0;
            arfenhouseVotes = arfenhouseNominees.ToDictionary(p => p, p => 0);
            screen = Screen.ArfenhouseVote;
            return;
        }

        EnterBoard();
    }

    void CastArfenhouseVote(Player nominee)
    {
        arfenhouseVotes[nominee]++;
        votingPlayerIndex++;

        if (votingPlayerIndex >= votingPlayers.Count)
        {
            int maxVotes = arfenhouseVotes.Values.Max();
            var winners = arfenhouseVotes.Where(kv => kv.Value == maxVotes).Select(kv => kv.Key).ToList();
            Game.ArfPlayer = winners[new Random().Next(winners.Count)];
            EnterBoard();
        }
    }

    void EnterBoard()
    {
        screen = Screen.Board;
        Session.Start(); // fire-and-forget: picks up immediately if the first player is a CPU
    }

    (int row, int col) GetGridPosition(int index)
    {
        return index switch
        {
            0 => (11, 11),
            >= 1 and <= 9 => (11, 11 - index),
            10 => (11, 1),
            >= 11 and <= 19 => (11 - (index - 10), 1),
            20 => (1, 1),
            >= 21 and <= 29 => (1, 1 + (index - 20)),
            30 => (1, 11),
            >= 31 and <= 39 => (1 + (index - 30), 11),
            _ => (1, 1)
        };
    }

    (double leftPct, double topPct) GetTokenPosition(int index)
    {
        const double corner = 14.0;
        const double cell = (100.0 - 2 * corner) / 9.0;

        double TrackCenter(int track) =>
            track == 0 ? corner / 2 :
            track == 10 ? 100 - corner / 2 :
            corner + cell * (track - 1) + cell / 2;

        return index switch
        {
            0 => (TrackCenter(10), TrackCenter(10)),
            >= 1 and <= 9 => (TrackCenter(10 - index), TrackCenter(10)),
            10 => (TrackCenter(0), TrackCenter(10)),
            >= 11 and <= 19 => (TrackCenter(0), TrackCenter(10 - (index - 10))),
            20 => (TrackCenter(0), TrackCenter(0)),
            >= 21 and <= 29 => (TrackCenter(index - 20), TrackCenter(0)),
            30 => (TrackCenter(10), TrackCenter(0)),
            >= 31 and <= 39 => (TrackCenter(10), TrackCenter(index - 30)),
            _ => (0, 0)
        };
    }

    void Quit() => Environment.Exit(0);
}